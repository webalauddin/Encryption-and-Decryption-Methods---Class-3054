<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="10dp"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data Encryption:"
        android:textColor="#000000"
        android:textSize="20dp"
        android:textStyle="bold"
        />


    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enUserName"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg"
            android:hint="User Name"
            android:textColor="@color/black"
            android:inputType="textPersonName"
            android:padding="3dp"
            android:drawableLeft="@drawable/name"
            android:drawableTint="#FF6D00"
            />


    </com.google.android.material.textfield.TextInputLayout>



    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enPhone"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg"
            android:hint="Phone"
            android:inputType="phone"
            android:textColor="@color/black"
            android:padding="3dp"
            android:drawableLeft="@drawable/phone"
            android:drawableTint="#00B8D4"
            />


    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enPassword"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg"
            android:hint="Password"
            android:inputType="text"
            android:textColor="@color/black"
            android:padding="3dp"
            android:drawableLeft="@drawable/password"
            android:drawableTint="#D50000"
            />

    </com.google.android.material.textfield.TextInputLayout>


    <Button
        android:id="@+id/encryptedButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Click Here to Encrypt Data"
        android:textAllCaps="false"
        android:layout_gravity="center"
        android:textSize="20dp"
        android:background="#00C853"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        />



    <!--Data Decryption-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data Decryption:"
        android:textColor="#000000"
        android:textSize="20dp"
        android:textStyle="bold"
        />


    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_margin="5dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/deUserName"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg"
            android:hint="User Name"
            android:textColor="@color/black"
            android:inputType="textPersonName"
            android:padding="3dp"
            android:drawableLeft="@drawable/name"
            android:drawableTint="#FF6D00"
            />


    </com.google.android.material.textfield.TextInputLayout>



    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dePhone"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg"
            android:hint="Phone"
            android:inputType="phone"
            android:textColor="@color/black"
            android:padding="3dp"
            android:drawableLeft="@drawable/phone"
            android:drawableTint="#00B8D4"
            />


    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dePassword"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:padding="3dp"
            android:drawableLeft="@drawable/password"
            android:drawableTint="#D50000"
            />

    </com.google.android.material.textfield.TextInputLayout>


    <Button
        android:id="@+id/decryptedButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Click Here to Decrypt Data"
        android:textAllCaps="false"
        android:layout_gravity="center"
        android:textSize="20dp"
        android:background="#FF6D00"
        android:textColor="@color/white"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        />

    <TextView
        android:id="@+id/result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="result"
        android:textColor="#000000"
        android:textSize="18dp"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        />




</LinearLayout>